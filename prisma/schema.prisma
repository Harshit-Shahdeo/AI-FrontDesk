generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Business {
  id             String @id @default(cuid())

  name           String
  ownerName      String
  ownerPhone     String

  status         BusinessStatus @default(ACTIVE)

  customers      Customer[]
  services       Service[]
  appointments   Appointment[]
  businessHours  BusinessHours[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Customer {
  id             String @id @default(cuid())

  name           String
  phone          String
  email          String?

  businessId     String
  business       Business @relation(fields: [businessId], references: [id])

  appointments   Appointment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([id, businessId])
}

model Service {
  id             String @id @default(cuid())

  name           String
  description    String?

  duration       Int
  price          Decimal @db.Decimal(10, 2)

  isActive       Boolean @default(true)

  businessId     String
  business       Business @relation(fields: [businessId], references: [id])

  appointments   Appointment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Appointment {
  id               String @id @default(cuid())

  appointmentAt    DateTime
  appointmentEndAt DateTime

  duration         Int
  price            Decimal @db.Decimal(10, 2)

  status           AppointmentStatus @default(SCHEDULED)

  businessId       String
  customerId       String
  serviceId        String

  business         Business @relation(fields: [businessId], references: [id])
  customer         Customer @relation(fields: [customerId], references: [id])
  service          Service @relation(fields: [serviceId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BusinessHours {
  id               String @id @default(cuid())

  businessId       String
  business         Business @relation(fields: [businessId], references: [id])

  /// ISO-8601
  /// 1 = Monday
  /// 2 = Tuesday
  /// 3 = Wednesday
  /// 4 = Thursday
  /// 5 = Friday
  /// 6 = Saturday
  /// 7 = Sunday
  dayOfWeek        Int

  isOpen           Boolean @default(true)

  opensAtMinutes   Int
  closesAtMinutes  Int

  breakPeriods     BusinessBreak[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
}

model BusinessBreak {
  id                  String @id @default(cuid())

  businessHoursId     String
  businessHours       BusinessHours @relation(fields: [businessHoursId], references: [id])

  startsAtMinutes     Int
  endsAtMinutes       Int

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}